# Postgres. Local: postgresql://postgres:postgres@127.0.0.1:5432/shopinbox
# Host (VibeHost): ưu tiên postgresql://... trong DATABASE_URL / DB_URI / DB_URL.
# Nếu URL tự sinh không phải URI, app ghép DB_HOST + DB_PORT + DB_NAME + DB_PASSWORD (+ DB_USER).
# Nếu panel bắt TLS: thêm ?sslmode=no-verify hoặc DATABASE_SSL=1
DATABASE_URL=
# DATABASE_SSL=1

# Tùy chọn — Postgres Docker (`docker compose up -d`), cổng 5433 để khỏi trùng Postgres local:
# DATABASE_URL="postgresql://shopinbox:shopinbox@127.0.0.1:5433/shopinbox"

# Local: chuỗi dưới đủ để chạy máy. Production phải đổi (≥ 32 ký tự, không dùng chuỗi mẫu).
SESSION_SECRET="shopinbox-dev-session-secret-change-me"
# Super admin: email này vào shop nền tảng (`platform`), không phải shop khách.
# Chủ shop đăng ký đầu tiên không còn được tự phong Super admin.
# SUPER_ADMIN_EMAIL=ban@gmail.com
# Tùy chọn — khóa riêng để mã hóa token kênh (nếu trống dùng SESSION_SECRET).
# TOKEN_ENCRYPTION_KEY=
# COOKIE_SECURE=1
# URL công khai. Local có thể để trống (app fallback localhost:3000).
# Production / VibeHost: BẮT BUỘC https://shopinbox.n2.tingon.xyz (không để localhost).
# NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=
# Production ép HTTPS (mặc định bật). Đặt 0 chỉ khi proxy đã chặn HTTP và app không được tự redirect.
# FORCE_HTTPS=0

# Cloudflare (DNS cam / proxied): SSL Full (strict) + Bot Fight Mode trên dashboard.
# Bật CLOUDFLARE_ONLY=1 sau khi domain đã trỏ qua Cloudflare để chặn vào thẳng origin.
# CLOUDFLARE_ONLY=1

# Backup DB: production tự chạy sau khi start (mỗi 24h). Tắt: BACKUP_ENABLED=0
# Production nên gắn volume vào BACKUP_DIR. Cron ngoài: POST /api/cron/backup + CRON_SECRET.
# BACKUP_ENABLED=1
# BACKUP_DIR=/data/shopinbox-backups
# BACKUP_KEEP=14
# BACKUP_INTERVAL_HOURS=24
# CRON_SECRET=

# Meta (Facebook Messenger + Instagram DM) — bắt buộc App ID + Secret để hiện nút "Kết nối với Facebook/Instagram"
# Lấy App ID / App Secret từ Meta for Developers → Settings → Basic.
# Callback OAuth (dán vào Meta → Facebook Login → Valid OAuth Redirect URIs):
#   {NEXT_PUBLIC_APP_URL}/api/connect/meta/callback
# Webhook (dán vào Meta → Messenger → Webhooks):
#   {NEXT_PUBLIC_APP_URL}/api/webhooks/meta
# META_APP_ID=
# META_APP_SECRET=
# Tuỳ chọn — nếu trống, app dùng NEXT_PUBLIC_APP_URL + /api/connect/meta/callback
# META_REDIRECT_URI=http://localhost:3000/api/connect/meta/callback
# META_WEBHOOK_VERIFY_TOKEN=

# Zalo Official Account — tuỳ chọn. Comment để host không bắt buộc khi chưa dùng Zalo.
# ZALO_APP_ID=
# ZALO_APP_SECRET=
# ZALO_WEBHOOK_VERIFY_TOKEN=
# Tuỳ chọn — nếu trống, app dùng NEXT_PUBLIC_APP_URL + /api/connect/zalo/callback
# ZALO_REDIRECT_URI=http://localhost:3000/api/connect/zalo/callback

# Shopify Partner (bước 1: OAuth + webhook). Tạo app trên partners.shopify.com.
# Allowed redirection URL: {NEXT_PUBLIC_APP_URL}/api/connect/shopify/callback
# GDPR + app/uninstalled webhook: {NEXT_PUBLIC_APP_URL}/api/webhooks/shopify
# SHOPIFY_API_KEY=
# SHOPIFY_API_SECRET=
# SHOPIFY_SCOPES=read_customers,read_orders
# SHOPIFY_REDIRECT_URI=

# Thư mục lưu ảnh Inbox (mặc định: ./storage/uploads). Production nên trỏ volume bền.
# UPLOAD_DIR=/data/shopinbox-uploads

# Google Sign-In — tuỳ chọn. Production: GOOGLE_REDIRECT_URI = {NEXT_PUBLIC_APP_URL}/api/auth/google/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=

# Gửi mã OTP đăng ký qua Gmail — tuỳ chọn. Production cần App Password thật.
# https://myaccount.google.com/apppasswords
# GMAIL_USER=
# GMAIL_APP_PASSWORD=
# SMTP_FROM="ShopInbox <ban@gmail.com>"
# EMAIL_OTP_DEV_LOG=1

DATABASE_URL="postgresql://shopinbox:shopinbox@localhost:5433/shopinbox"
SESSION_SECRET="shopinbox-dev-session-secret-change-me"

# Meta (Facebook Messenger + Instagram DM) — điền khi deploy, không commit giá trị thật
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://localhost:3000/api/connect/meta/callback
META_WEBHOOK_VERIFY_TOKEN=

# Zalo Official Account
ZALO_APP_ID=
ZALO_APP_SECRET=
ZALO_REDIRECT_URI=http://localhost:3000/api/connect/zalo/callback

# URL công khai của app (dùng hiển thị webhook; production dùng domain thật)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Google Sign-In (OAuth 2.0)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

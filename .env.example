# Postgres local (mặc định). Cổng 5432 — không cần Docker.
# Máy Windows dev này: user/password postgres/postgres, database shopinbox.
# Nếu máy bạn khác credential, sửa USER:PASSWORD (ký tự đặc biệt trong mật khẩu phải URL-encode).
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/shopinbox"

# Tùy chọn — Postgres Docker (`docker compose up -d`), cổng 5433 để khỏi trùng Postgres local:
# DATABASE_URL="postgresql://shopinbox:shopinbox@127.0.0.1:5433/shopinbox"

SESSION_SECRET="shopinbox-dev-session-secret-change-me"

# Meta (Facebook Messenger + Instagram DM) — bắt buộc 3 biến đầu để hiện nút "Kết nối với Facebook/Instagram"
# Lấy App ID / App Secret từ Meta for Developers → Settings → Basic.
# Redirect URI phải khớp Valid OAuth Redirect URIs trên Meta (local: localhost; webhook thật cần HTTPS/ngrok).
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://localhost:3000/api/connect/meta/callback
# Dùng khi verify webhook Meta (GET /api/webhooks/meta) — không bắt buộc để bật nút OAuth
META_WEBHOOK_VERIFY_TOKEN=

# Zalo Official Account — bắt buộc 3 biến để hiện nút "Kết nối với Zalo"
ZALO_APP_ID=
ZALO_APP_SECRET=
ZALO_REDIRECT_URI=http://localhost:3000/api/connect/zalo/callback

# URL công khai của app (hiển thị webhook URL trong Settings; production/ngrok dùng domain thật)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Google Sign-In (OAuth 2.0)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

{
  "manifest_version": 3,
  "name": "Nexo",
  "version": "0.2.0",
  "description": "Mở Inbox Nexo trên Chrome. Có thể gắn thử chat website. Không đọc Facebook.",
  "permissions": ["storage", "activeTab", "scripting"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Nexo"
  },
  "background": {
    "service_worker": "background.js"
  }
}

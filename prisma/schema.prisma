generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Channel {
  facebook
  zalo
  instagram
  web
}

enum ChannelStatus {
  disconnected
  ready
}

enum StaffRole {
  owner
  staff
}

enum ConversationTag {
  new
  consulting
  closed
  spam
}

enum OrderStatus {
  new
  confirmed
  shipping
  done
  cancelled
}

enum MessageSender {
  customer
  shop
}

model Shop {
  id               String             @id
  name             String
  createdAt        DateTime           @default(now())
  staff            Staff[]
  channelAccounts  ChannelAccount[]
  customers        Customer[]
  conversations    Conversation[]
  messages         Message[]
  orders           Order[]
  products         Product[]
  quickReplies     QuickReply[]

  @@map("shops")
}

model Staff {
  id           String         @id
  shopId       String
  shop         Shop           @relation(fields: [shopId], references: [id], onDelete: Cascade)
  name         String
  email        String         @unique
  passwordHash String
  role         StaffRole
  createdAt    DateTime       @default(now())
  assignedChats Conversation[]
  sentMessages Message[]

  @@index([shopId])
  @@map("staff")
}

model ChannelAccount {
  id      String        @id
  shopId  String
  shop    Shop          @relation(fields: [shopId], references: [id], onDelete: Cascade)
  channel Channel
  name    String
  status  ChannelStatus
  note    String

  @@unique([shopId, channel])
  @@map("channel_accounts")
}

model Customer {
  id            String              @id
  shopId        String
  shop          Shop                @relation(fields: [shopId], references: [id], onDelete: Cascade)
  name          String
  phone         String?
  email         String?
  address       String?
  note          String?
  identities    CustomerIdentity[]
  conversations Conversation[]
  orders        Order[]

  @@index([shopId])
  @@index([shopId, phone])
  @@map("customers")
}

model CustomerIdentity {
  id         String   @id
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  channel    Channel
  externalId String?

  @@unique([customerId, channel])
  @@index([channel, externalId])
  @@map("customer_identities")
}

model Conversation {
  id         String           @id
  shopId     String
  shop       Shop             @relation(fields: [shopId], references: [id], onDelete: Cascade)
  customerId String
  customer   Customer         @relation(fields: [customerId], references: [id], onDelete: Cascade)
  staffId    String?
  staff      Staff?           @relation(fields: [staffId], references: [id], onDelete: SetNull)
  channel    Channel
  lastMessage String          @default("")
  lastAt     DateTime
  unread     Int              @default(0)
  tag        ConversationTag
  messages   Message[]
  orders     Order[]

  @@index([shopId, lastAt])
  @@index([customerId])
  @@index([staffId])
  @@map("conversations")
}

model Message {
  id             String        @id @default(cuid())
  shopId         String
  shop           Shop          @relation(fields: [shopId], references: [id], onDelete: Cascade)
  conversationId String
  conversation   Conversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  staffId        String?
  staff          Staff?        @relation(fields: [staffId], references: [id], onDelete: SetNull)
  sender         MessageSender
  text           String
  createdAt      DateTime      @default(now())

  @@index([conversationId, createdAt])
  @@index([shopId])
  @@map("messages")
}

model Product {
  id      String      @id
  shopId  String
  shop    Shop        @relation(fields: [shopId], references: [id], onDelete: Cascade)
  name    String
  sku     String?
  price   Int
  inStock Boolean     @default(true)
  items   OrderItem[]

  @@index([shopId])
  @@map("products")
}

model Order {
  id             String       @id
  shopId         String
  shop           Shop         @relation(fields: [shopId], references: [id], onDelete: Cascade)
  customerId     String
  customer       Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Restrict)
  code           String
  address        String
  status         OrderStatus
  createdAt      DateTime     @default(now())
  items          OrderItem[]

  @@unique([shopId, code])
  @@index([customerId])
  @@index([conversationId])
  @@index([shopId, createdAt])
  @@map("orders")
}

model OrderItem {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  name      String
  qty       Int
  price     Int

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

model QuickReply {
  id     String @id
  shopId String
  shop   Shop   @relation(fields: [shopId], references: [id], onDelete: Cascade)
  title  String
  text   String

  @@index([shopId])
  @@map("quick_replies")
}

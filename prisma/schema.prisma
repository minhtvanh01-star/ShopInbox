generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Channel {
  facebook
  zalo
  instagram
  web
  shopify
}

enum ChannelStatus {
  disconnected
  connecting
  ready
}

enum ConversationTag {
  new
  consulting
  closed
  spam
}

enum OrderStatus {
  new
  confirmed
  shipping
  done
  cancelled
}

enum MessageSender {
  customer
  shop
}

enum ShopPlan {
  trial
  starter
  pro
  business
}

enum ShopSupportStatus {
  ok
  watching
  needs_help
  in_progress
}

enum ShopSupportTopic {
  none
  onboarding
  channel
  billing
  bug
  other
}

model Shop {
  id                    String             @id
  name                  String
  createdAt             DateTime           @default(now())
  /** Phút idle trước khi nhả claim hội thoại (nhân viên). */
  replyClaimTtlMinutes  Int                @default(15)
  /** Số thành viên active tối đa trên shop (mặc định 3, trần chạy thử 5). */
  maxUsersPerShop       Int                @default(3)
  /** Null = chủ shop chưa xong màn cấu hình — chặn Inbox/kênh/nhân viên. */
  setupCompletedAt      DateTime?
  /** Super admin tạm khóa shop — nhân viên shop không đăng nhập được. */
  suspendedAt           DateTime?
  planCode              ShopPlan           @default(trial)
  planExpiresAt         DateTime?
  supportStatus         ShopSupportStatus  @default(ok)
  supportTopic          ShopSupportTopic   @default(none)
  supportNote           String             @default("")
  staff                 Staff[]
  invites               ShopInvite[]
  channelAccounts       ChannelAccount[]
  customers             Customer[]
  conversations         Conversation[]
  messages              Message[]
  orders                Order[]
  products              Product[]
  productGroups         ProductGroup[]
  quickReplies          QuickReply[]
  autoReplyRules        AutoReplyRule[]
  orderChecklistTemplates OrderChecklistTemplate[]
  oauthPagePicks        OAuthPagePick[]
  auditLogs             AuditLog[]
  messageReactions      MessageReaction[]

  @@map("shops")
}

model Role {
  code        String           @id
  name        String
  description String           @default("")
  isSystem    Boolean          @default(true)
  isActive    Boolean          @default(true)
  sortOrder   Int              @default(0)
  createdAt   DateTime         @default(now())
  permissions RolePermission[]
  staff       Staff[]

  @@map("roles")
}

model Permission {
  code        String           @id
  name        String
  description String           @default("")
  group       String           @default("") @map("group_name")
  roles       RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleCode       String
  permissionCode String
  role           Role       @relation(fields: [roleCode], references: [code], onDelete: Cascade)
  permission     Permission @relation(fields: [permissionCode], references: [code], onDelete: Cascade)

  @@id([roleCode, permissionCode])
  @@map("role_permissions")
}

model Staff {
  id            String         @id
  shopId        String
  shop          Shop           @relation(fields: [shopId], references: [id], onDelete: Cascade)
  name          String
  email         String         @unique
  emailVerifiedAt DateTime?
  passwordHash  String?
  googleId      String?        @unique
  avatarUrl     String?
  phone         String?
  roleCode      String
  role          Role           @relation(fields: [roleCode], references: [code], onDelete: Restrict)
  isActive      Boolean        @default(true)
  /** Quyền nền tảng: xem/khóa mọi shop. Không gắn với role trong shop. */
  isSuperAdmin  Boolean        @default(false)
  sessionVersion Int           @default(0)
  createdAt     DateTime       @default(now())
  assignedChats Conversation[]
  sentMessages  Message[]
  messageReactions MessageReaction[]
  auditLogs     AuditLog[]
  checklistMarks OrderChecklistCheck[]
  createdInvites ShopInvite[]

  @@index([shopId])
  @@index([roleCode])
  @@index([shopId, isActive])
  @@map("staff")
}

/** Link mời nhân viên vào đúng shop (token lưu hash). */
model ShopInvite {
  id               String    @id
  shopId           String
  shop             Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  tokenHash        String    @unique
  email            String?
  roleCode         String
  expiresAt        DateTime
  usedAt           DateTime?
  revokedAt        DateTime?
  createdByStaffId String
  createdBy        Staff     @relation(fields: [createdByStaffId], references: [id], onDelete: Restrict)
  createdAt        DateTime  @default(now())

  @@index([shopId])
  @@map("shop_invites")
}

/** Đếm lần đăng nhập sai theo email — cửa sổ trượt, tự hết sau LOGIN_FAIL_WINDOW_MS. */
model AuthLoginThrottle {
  email           String   @id
  failCount       Int      @default(0)
  windowStartedAt DateTime
  updatedAt       DateTime @updatedAt

  @@map("auth_login_throttles")
}

/** OTP email (đăng ký…) — mã đã hash, payload tạm (tên + passwordHash). */
model EmailOtpChallenge {
  id          String   @id @default(cuid())
  email       String
  purpose     String
  codeHash    String
  payloadJson String
  expiresAt   DateTime
  attempts    Int      @default(0)
  lastSentAt  DateTime @default(now())
  createdAt   DateTime @default(now())

  @@index([email, purpose])
  @@index([expiresAt])
  @@map("email_otp_challenges")
}

model AuditLog {
  id         String   @id @default(cuid())
  createdAt  DateTime @default(now())
  shopId     String?
  shop       Shop?    @relation(fields: [shopId], references: [id], onDelete: SetNull)
  actorId    String?
  actor      Staff?   @relation(fields: [actorId], references: [id], onDelete: SetNull)
  actorEmail String?
  actorRole  String?
  action     String
  entityType String?
  entityId   String?
  metadata   Json?
  ip         String?
  userAgent  String?

  @@index([actorId])
  @@index([createdAt])
  @@index([action])
  @@index([entityType, entityId])
  @@index([shopId, createdAt])
  @@map("audit_logs")
}

model ChannelAccount {
  id             String        @id
  shopId         String
  shop           Shop          @relation(fields: [shopId], references: [id], onDelete: Cascade)
  channel        Channel
  name           String
  status         ChannelStatus
  note           String
  appId          String?
  appSecret      String?
  pageId         String?
  linkedPageId   String?
  webhookSecret  String?
  oaId           String?
  accessToken    String?
  refreshToken   String?
  displayName    String?
  expiresAt      DateTime?
  connectedAt    DateTime?
  lastWebhookAt  DateTime?

  @@unique([shopId, channel])
  @@map("channel_accounts")
}

model Customer {
  id            String              @id
  shopId        String
  shop          Shop                @relation(fields: [shopId], references: [id], onDelete: Cascade)
  name          String
  phone         String?
  email         String?
  address       String?
  note          String?
  /** Ảnh đại diện từ Meta/Zalo (URL HTTPS). */
  avatarUrl     String?
  identities    CustomerIdentity[]
  conversations Conversation[]
  orders        Order[]

  @@index([shopId])
  @@index([shopId, phone])
  @@map("customers")
}

model CustomerIdentity {
  id         String   @id
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  channel    Channel
  externalId String?

  @@unique([customerId, channel])
  @@unique([channel, externalId])
  @@index([channel, externalId])
  @@map("customer_identities")
}

model Conversation {
  id         String           @id
  shopId     String
  shop       Shop             @relation(fields: [shopId], references: [id], onDelete: Cascade)
  customerId String
  customer   Customer         @relation(fields: [customerId], references: [id], onDelete: Cascade)
  /** Nhân viên đang nhận trả lời (claim) — người khác không gửi được khi claim còn hiệu lực. */
  staffId    String?
  staff      Staff?           @relation(fields: [staffId], references: [id], onDelete: SetNull)
  replyClaimedAt DateTime?
  channel    Channel
  lastMessage String          @default("")
  lastAt     DateTime
  unread     Int              @default(0)
  tag        ConversationTag
  messages   Message[]
  orders     Order[]

  @@unique([shopId, customerId, channel])
  @@index([shopId, lastAt])
  @@index([customerId])
  @@index([staffId])
  @@map("conversations")
}

model Message {
  id                 String            @id @default(cuid())
  shopId             String
  shop               Shop              @relation(fields: [shopId], references: [id], onDelete: Cascade)
  conversationId     String
  conversation       Conversation      @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  staffId            String?
  staff              Staff?            @relation(fields: [staffId], references: [id], onDelete: SetNull)
  sender             MessageSender
  text               String
  attachmentType     String?
  attachmentUrl      String?
  attachmentName     String?
  externalMessageId  String?
  /** Meta delivery watermark — khách đã nhận tin shop. */
  deliveredAt        DateTime?
  /** Meta read watermark — khách đã xem tin shop. */
  readAt             DateTime?
  createdAt          DateTime          @default(now())
  reactions          MessageReaction[]

  @@unique([shopId, externalMessageId])
  @@index([conversationId, createdAt])
  @@index([shopId])
  @@map("messages")
}

/** Reaction trên tin — staff:{id} hoặc customer:{psid}. */
model MessageReaction {
  id         String   @id @default(cuid())
  shopId     String
  shop       Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  messageId  String
  message    Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  staffId    String?
  staff      Staff?   @relation(fields: [staffId], references: [id], onDelete: SetNull)
  reactorKey String
  emoji      String
  createdAt  DateTime @default(now())

  @@unique([messageId, reactorKey])
  @@index([shopId])
  @@index([messageId])
  @@map("message_reactions")
}

enum VatPolicy {
  exempt
  taxable
  zero
}

model ProductGroup {
  id        String    @id
  shopId    String
  shop      Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  name      String
  sortOrder Int       @default(0)
  products  Product[]

  @@unique([shopId, name])
  @@index([shopId, sortOrder])
  @@map("product_groups")
}

model Product {
  id        String           @id
  shopId    String
  shop      Shop             @relation(fields: [shopId], references: [id], onDelete: Cascade)
  groupId   String?
  group     ProductGroup?    @relation(fields: [groupId], references: [id], onDelete: SetNull)
  code      String
  name      String
  vatPolicy VatPolicy        @default(exempt)
  /** Phần trăm thuế 0–100 khi vatPolicy = taxable. */
  taxRate   Int?
  selling   Boolean          @default(true)
  variants  ProductVariant[]
  items     OrderItem[]

  @@unique([shopId, code])
  @@index([shopId])
  @@index([groupId])
  @@map("products")
}

model ProductVariant {
  id        String      @id
  productId String
  product   Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku       String?
  name      String
  price     Int
  costPrice Int         @default(0)
  selling   Boolean     @default(true)
  sortOrder Int         @default(0)
  items     OrderItem[]

  @@index([productId, sortOrder])
  @@map("product_variants")
}

model Order {
  id             String       @id
  shopId         String
  shop           Shop         @relation(fields: [shopId], references: [id], onDelete: Cascade)
  customerId     String
  customer       Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Restrict)
  code           String
  address        String
  status         OrderStatus
  createdAt      DateTime     @default(now())
  items          OrderItem[]
  checklistChecks OrderChecklistCheck[]

  @@unique([shopId, code])
  @@index([customerId])
  @@index([conversationId])
  @@index([shopId, createdAt])
  @@map("orders")
}

model OrderItem {
  id        String          @id @default(cuid())
  orderId   String
  order     Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String?
  product   Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  name      String
  qty       Int
  price     Int

  @@index([orderId])
  @@index([productId])
  @@index([variantId])
  @@map("order_items")
}

/** Mục checklist vận hành đơn (cấu hình theo shop) — tick thủ công trên từng đơn. */
model OrderChecklistTemplate {
  id        String                @id
  shopId    String
  shop      Shop                  @relation(fields: [shopId], references: [id], onDelete: Cascade)
  label     String
  sortOrder Int                   @default(0)
  enabled   Boolean               @default(true)
  checks    OrderChecklistCheck[]

  @@index([shopId, sortOrder])
  @@map("order_checklist_templates")
}

model OrderChecklistCheck {
  id            String                 @id
  orderId       String
  order         Order                  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  templateId    String?
  template      OrderChecklistTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  done          Boolean                @default(false)
  doneAt        DateTime?
  doneByStaffId String?
  doneByStaff   Staff?                 @relation(fields: [doneByStaffId], references: [id], onDelete: SetNull)

  @@unique([orderId, templateId])
  @@index([templateId])
  @@index([doneByStaffId])
  @@map("order_checklist_checks")
}

model QuickReply {
  id     String @id
  shopId String
  shop   Shop   @relation(fields: [shopId], references: [id], onDelete: Cascade)
  title  String
  text   String

  @@index([shopId])
  @@map("quick_replies")
}

/** Phiên chọn Fanpage OAuth — token nằm trên server, cookie chỉ giữ id. */
model OAuthPagePick {
  id        String   @id
  shopId    String
  shop      Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  channel   Channel
  pagesJson String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([shopId])
  @@index([expiresAt])
  @@map("oauth_page_picks")
}

/** Trả lời tự động: ngoài giờ hoặc theo từ khóa (original ShopInbox). */
model AutoReplyRule {
  id              String   @id
  shopId          String
  shop            Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  enabled         Boolean  @default(true)
  /** off_hours | keyword */
  kind            String
  /** Từ khóa cách nhau bởi dấu phẩy (kind=keyword). */
  keywords        String   @default("")
  replyText       String
  /** Phút từ 0h VN — giờ mở cửa (kind=off_hours). */
  openMinute      Int?
  /** Phút từ 0h VN — giờ đóng cửa (kind=off_hours). */
  closeMinute     Int?
  /** Không gửi lại auto-reply cùng hội thoại trong khoảng này. */
  cooldownMinutes Int      @default(120)
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())

  @@index([shopId, enabled])
  @@map("auto_reply_rules")
}
